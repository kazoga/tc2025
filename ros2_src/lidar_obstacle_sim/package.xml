<?xml version="1.0"?>
<package format="3">
  <name>lidar_obstacle_sim</name>
  <version>0.0.1</version>
  <description>
    LiDAR-based obstacle avoidance simulator with static pylon obstacles on a road course.
    UTM-30 (2D LiDAR) and Mid-360-like 3D LiDAR are mounted on a simple robot.
  </description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime and build dependencies -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>gazebo_msgs</depend>

  <!-- Gazebo / gazebo_ros plugins -->
  <exec_depend>gazebo_ros_pkgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
