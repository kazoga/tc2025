<?xml version="1.6"?>
<sdf version="1.6">
  <world name="lidar_obstacle_world">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="lidar_sim_robot">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.1</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.1</iyy>
            <iyz>0.0</iyz>
            <izz>0.1</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 0.35 0.2</size>
            </box>
          </geometry>
        </collision>
        <visual name="base_visual">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 0.35 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
        <visual name="front_wedge">
          <pose>0.27 0 0.15 0 0 0</pose>
          <geometry>
            <box>
              <size>0.2 0.12 0.08</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.3 0.3 1</ambient>
            <diffuse>1.0 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <visual name="front_arrow_shaft">
          <pose>0.32 0 0.24 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.01</radius>
              <length>0.25</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.5 1.0 1</ambient>
            <diffuse>0.1 0.5 1.0 1</diffuse>
          </material>
        </visual>
        <visual name="front_arrow_head">
          <pose>0.445 0 0.24 0 1.5707 0</pose>
          <geometry>
            <cone>
              <radius>0.03</radius>
              <length>0.07</length>
            </cone>
          </geometry>
          <material>
            <ambient>0.1 0.5 1.0 1</ambient>
            <diffuse>0.1 0.5 1.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="simple_obstacle">
      <static>true</static>
      <pose>2 0 0 0 0 0</pose>
      <link name="box">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.6 0.6 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.6 0.6 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.2 1</ambient>
            <diffuse>0.2 0.7 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
