<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="road_straight_moving_obstacle">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 直線 100m 幅 3m -->
    <include>
      <uri>model://road_straight_100m_w3</uri>
    </include>

    <!-- ロボット配置 -->
    <include>
      <uri>model://simple_robot</uri>
      <name>simple_robot</name>
      <pose>1 0 0.5 0 0 0</pose>
    </include>

    <!-- 直線路上の移動障害物 -->
    <include>
      <uri>model://moving_obstacle</uri>
      <name>moving_obstacle_front</name>
      <pose>40 0 0.25 0 0 3.14159</pose>
      <plugin name="moving_obstacle_front_plugin" filename="libmoving_obstacle_plugin.so">
        <robot_pose_topic>/amcl_pose</robot_pose_topic>
        <velocity>-0.4 0 0</velocity>
        <stop_distance>1.0</stop_distance>
        <start_distance>20.0</start_distance>
        <use_sim_time>true</use_sim_time>
      </plugin>
    </include>

    <include>
      <uri>model://moving_obstacle</uri>
      <name>moving_obstacle_back</name>
      <pose>90 0 0.25 0 0 3.14159</pose>
      <plugin name="moving_obstacle_back_plugin" filename="libmoving_obstacle_plugin.so">
        <robot_pose_topic>/amcl_pose</robot_pose_topic>
        <velocity>-1.0 0 0</velocity>
        <stop_distance>1.0</stop_distance>
        <start_distance>20.0</start_distance>
        <use_sim_time>true</use_sim_time>
      </plugin>
    </include>
  </world>
</sdf>
