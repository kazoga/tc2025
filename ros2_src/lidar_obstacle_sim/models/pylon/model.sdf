<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="pylon">
    <static>true</static>
    <link name="link">
      <!--
           長さ0.7mのシリンダーが地面上に立つよう、重心位置を高さ0.35mに設定する。
           元の設定ではモデル中心が地面と一致していたため、上端が0.35mとなり、
           高さ0.49mにあるUTM-30のレーザー平面より低くビームが当たらなかった。
      -->
      <pose>0 0 0.35 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.01</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.7</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.7</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 0.5 0.0 1</ambient>
          <diffuse>1.0 0.5 0.0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
