<?xml version="1.0"?>
<sdf version="1.6">

  <model name="icart_middle_robot">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <!-- ===================================================== -->
    <!--                    Base Link                          -->
    <!-- ===================================================== -->
    <!-- 条件:
         - 車体奥行: 0.6 m
         - 車体幅: 0.4 m（Visual）
         - Collision 幅: 0.36 m（Wheel collision と干渉しないように）
         - 厚み: 0.5 m
         - 車軸高さ = 0.15 m → 本体底面高さと一致
         - 本体 center = 0.15 + 0.25 = 0.4 m
    -->
    <link name="base_link">
      <pose>0 0 0.4 0 0 0</pose>

      <inertial>
        <mass>50.0</mass>
        <inertia>
          <ixx>5.0</ixx>
          <iyy>5.0</iyy>
          <izz>5.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 0.36 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 0.4 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.8 1</ambient>
          <diffuse>0.2 0.2 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ===================================================== -->
    <!--                       Wheels                           -->
    <!-- ===================================================== -->
    <!-- 条件:
         - 半径 0.15 m
         - 厚み 0.05 m
         - TREAD = 0.6 → ±0.3
         - 円柱Z軸を +Y に向ける（roll=90°）
         - Base 前面(x=0.3) に円柱前面が一致 → x=0.15
    -->

    <link name="left_wheel_link">
      <pose>0.15 0.3 0.15 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel_link">
      <pose>0.15 -0.3 0.15 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <iyy>0.01</iyy>
          <izz>0.005</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- ===================================================== -->
    <!--                     Rear Caster                       -->
    <!-- ===================================================== -->
    <!-- 条件:
         - 半径 0.07 m（拡大）
         - 中心 x = -0.3（Base 後端に一致）
         - 中心 z = 0.07（床接触）
         - Joint は fixed（球が床との摩擦で回転しキャスター挙動を模擬）
    -->

    <link name="rear_caster_link">
      <pose>-0.3 0 0.07 0 0 0</pose>

      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="rear_caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_caster_link</child>
      <pose>-0.3 0 0.07 0 0 0</pose>
    </joint>

    <!-- ===================================================== -->
    <!--                 UTM-30LX (2D LiDAR)                   -->
    <!-- ===================================================== -->

    <link name="laser">
      <pose>0.075 0 0.49 0 0 0</pose>

      <sensor name="utm30" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>40</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>1080</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle>
              <max_angle>2.35619</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.1</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>

        <plugin name="utm30_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=/scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- ===================================================== -->
    <!--                  Mid-360 3D LiDAR                     -->
    <!-- ===================================================== -->

    <link name="mid360_frame">
      <pose>-0.425 0 1.005 0 0 0</pose>

      <sensor name="mid360" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>10</update_rate>

        <ray>
          <scan>
            <horizontal>
              <samples>900</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>

            <vertical>
              <samples>24</samples>
              <resolution>1</resolution>
              <min_angle>-0.122173</min_angle>
              <max_angle>0.907571</max_angle>
            </vertical>
          </scan>

          <range>
            <min>0.2</min>
            <max>40.0</max>
            <resolution>0.02</resolution>
          </range>
        </ray>

        <plugin name="mid360_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=/mid360/livox/lidar</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>mid360_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <!-- ===================================================== -->
    <!--                 Diff Drive Plugin                     -->
    <!-- ===================================================== -->

    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/ypspur_ros/odom</remapping>
      </ros>

      <update_rate>50</update_rate>

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.6</wheel_separation>
      <wheel_diameter>0.3</wheel_diameter>

      <publish_odom>true</publish_odom>
      <publish_tf>true</publish_tf>

      <odom_frame>odom</odom_frame>
      <base_frame>base_link</base_frame>
    </plugin>

  </model>
</sdf>

