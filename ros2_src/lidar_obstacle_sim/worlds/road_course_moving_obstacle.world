<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="road_straight_moving_obstacle">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 直線 100m 幅 3m -->
    <include>
      <uri>model://road_straight_100m_w3</uri>
    </include>

    <!-- ロボット配置 -->
    <include>
      <uri>model://simple_robot</uri>
      <name>simple_robot</name>
      <pose>1 0 0.5 0 0 0</pose>
    </include>

    <!-- 直線路上の移動障害物 -->
    <include>
      <uri>model://moving_obstacle</uri>
      <name>moving_obstacle_front</name>
      <pose>40 0 0.25 0 0 3.14159</pose>
    </include>

    <include>
      <uri>model://moving_obstacle</uri>
      <name>moving_obstacle_back</name>
      <pose>80 0 0.25 0 0 3.14159</pose>
    </include>
  </world>
</sdf>
