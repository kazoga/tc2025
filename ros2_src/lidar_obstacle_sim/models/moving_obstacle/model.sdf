<?xml version="1.0"?>
<sdf version="1.6">
  <model name="moving_obstacle">
    <static>false</static>
    <pose>0 0 0.25 0 0 0</pose>
    <link name="body">
      <inertial>
        <mass>5.0</mass>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.5</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 0.5 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.2 0.2 1</ambient>
          <diffuse>0.9 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>

    <plugin name="moving_obstacle_plugin" filename="libmoving_obstacle_plugin.so">
      <robot_pose_topic>/amcl_pose</robot_pose_topic>
      <velocity>-0.5 0 0</velocity>
      <stop_distance>1.0</stop_distance>
      <start_distance>15.0</start_distance>
      <use_sim_time>true</use_sim_time>
    </plugin>
  </model>
</sdf>
